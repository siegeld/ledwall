# Marquee configuration. Copy to .env and fill in.
MARQUEE_DATABASE_URL=sqlite:////data/marquee.db
MARQUEE_SESSION_SECRET=change-me
MARQUEE_ADMIN_PASSWORD=change-me
# Which custom/<site>/shows directory the UI exports to and imports from.
# Mirrors the Makefile's SITE, which defaults the same way.
MARQUEE_SITE=dashboard
MARQUEE_SITE_TZ=America/New_York
MARQUEE_MEDIA_ROOT=/data/media
MARQUEE_FIRMWARE_ROOT=/data/firmware
# The gateware sets TFTP_SERVER_PORT=6969, so the panel BIOS asks there, not 69.
MARQUEE_TFTP_PORT=6969
MARQUEE_TFTP_ENABLED=true
MARQUEE_POLL_INTERVAL_S=15
MARQUEE_STATS_RETENTION_DAYS=30

# Live data (optional). A panel-bus fans out one upstream connection per feed
# over a websocket; bindings read `{bus:<topic>|<path>}` from its cache.
# Leave both unset and the live-data plane is simply off.
MARQUEE_BUS_URL=
MARQUEE_BUS_TOPICS=home.status
