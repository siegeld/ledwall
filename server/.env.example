# Marquee configuration. Copy to .env and fill in.
MARQUEE_DATABASE_URL=sqlite:////data/marquee.db
MARQUEE_SESSION_SECRET=change-me
MARQUEE_ADMIN_PASSWORD=change-me
# Which custom/<site>/ directory is yours: shows (what the UI exports to and
# imports from), data providers and module types are read from under it.
# Mirrors the Makefile's SITE, which defaults the same way.
MARQUEE_SITE=dashboard
MARQUEE_SITE_TZ=America/New_York
MARQUEE_MEDIA_ROOT=/data/media
MARQUEE_FIRMWARE_ROOT=/data/firmware
# The gateware sets TFTP_SERVER_PORT=6969, so the panel BIOS asks there, not 69.
MARQUEE_TFTP_PORT=6969
MARQUEE_TFTP_ENABLED=true
MARQUEE_POLL_INTERVAL_S=15
# Read into the api's settings but not acted on yet: nothing prunes card_stats.
MARQUEE_STATS_RETENTION_DAYS=30
# Card-chain discovery (ARCH.md §2b): the player sends one UDP packet a second
# to port 6990 of every card host. It tells chained cards their hop, names the
# server a chain member fetches its config from, and carries the clock that
# multi-card programs frame-sync on. There must be ONE sender per fleet: set
# this to false on any second player run against a copy of the database (a
# dev host). Default true.
MARQUEE_CHAIN_DISCOVERY=true
# Firmware sync (ARCH.md §2c), a thread in the api: keeps every card on its
# assigned image and writes each card's flash survival copy once the image has
# run for MARQUEE_FIRMWARE_SETTLE_S seconds. ONE per fleet, like discovery:
# false on a second marquee against a copy of the database. Default true, 600.
#MARQUEE_FIRMWARE_SYNC=true
#MARQUEE_FIRMWARE_SETTLE_S=600
# DDP input (doc/scenes.md, the `ddp` layer): the player listens on UDP 4048
# like a pixel controller, so WLED / xLights / LedFx can draw on a wall. It
# only shows where a show has a `ddp` layer. A second player on the same host
# cannot share the port -- set this false there. Default true, port 4048.
MARQUEE_DDP_ENABLED=true
#MARQUEE_DDP_PORT=4048

# Live data (optional). A panel-bus fans out one upstream connection per feed
# over a websocket; bindings read `{bus:<topic>|<path>}` from its cache.
# Leave both unset and the live-data plane is simply off.
MARQUEE_BUS_URL=
MARQUEE_BUS_TOPICS=home.status
# Extra places to load data providers (.py) from, colon separated, replacing
# the default: /custom/example/providers, /custom/<site>/providers,
# /data/providers (doc/providers.md).
#MARQUEE_PROVIDER_DIRS=
# Plex library mounts (compose). Override on a sender host without CIFS to the file estate.
#MARQUEE_SHARE_HOMEMOVIES=/share/homemovies
#MARQUEE_SHARE_MOVIES=/share/movies

# Dedicated panel link (compose profile `panel-link`, see doc/dedicated-link.md).
# PANEL_IF is the sender's second NIC; the rest describe the private /24 on it.
# Defaults are the documentation example; set your own in .env.
#PANEL_IF=eth1
#PANEL_SENDER_IP=192.168.61.1
#PANEL_CARD_IP=192.168.61.11
#PANEL_POOL_START=192.168.61.100
#PANEL_POOL_END=192.168.61.120
#PANEL_NETMASK=255.255.255.0

# Sender tuning (ARCH.md §4, "Pacing is the whole game"). Send each frame N
# times under one frame id (divide the card's packet_delay by N); the socket
# send buffer in bytes. Defaults 1 and 1048576.
#MARQUEE_REDUNDANT_COPIES=1
#MARQUEE_SND_BUF=1048576

# Where module-type files (.json) are read from, colon separated (custom/README.md).
# Setting it REPLACES the default: /custom/example/modules,
# /custom/<site>/modules, /data/modules.
#MARQUEE_MODULE_DIRS=
