+#if defined(CSR_SPIFLASH_MMAP_MASTER_CS_ADDR) && defined(ETH_UDP_BROADCAST)
+/* Per-card MAC, derived from the SPI flash unique ID.
+ *
+ * Without this the BIOS uses one compiled-in MAC for the WHOLE FLEET, so every
+ * card netboots as the same host at the same address. That is why the
+ * boot-server lookup upstream has to identify cards by ARP instead of by the
+ * address they came from, and it is why a DHCP reservation cannot target an
+ * individual card at BIOS time.
+ *
+ * MUST match sw_rust/barsign_disp/src/flash_id.rs exactly -- the firmware
+ * derives its MAC the same way, and if the two disagree the card takes one
+ * lease as the BIOS and a different one as the firmware.
+ *
+ * Safe to do here even though flashboot() runs later: the BIOS lives in the
+ * integrated ROM at 0x0, not XIP from this flash. phyconfig is saved and
+ * restored anyway, because flashboot() is the fallback that actually boots
+ * these cards today and it reads through the mmap interface.
+ */
+static uint8_t spi_xfer(uint8_t tx)
+{
+	while(!(spiflash_mmap_master_status_read() & (1 << CSR_SPIFLASH_MMAP_MASTER_STATUS_TX_READY_OFFSET)));
+	spiflash_mmap_master_rxtx_write(tx);
+	while(!(spiflash_mmap_master_status_read() & (1 << CSR_SPIFLASH_MMAP_MASTER_STATUS_RX_READY_OFFSET)));
+	return spiflash_mmap_master_rxtx_read();
+}
+
+static void derive_mac_from_flash(void)
+{
+	uint32_t saved_phyconfig = spiflash_mmap_master_phyconfig_read();
+	uint8_t uid[8];
+	int i;
+
+	/* 8-bit transfers, single width, mask=1 */
+	spiflash_mmap_master_phyconfig_write(
+		(8 << CSR_SPIFLASH_MMAP_MASTER_PHYCONFIG_LEN_OFFSET) |
+		(1 << CSR_SPIFLASH_MMAP_MASTER_PHYCONFIG_WIDTH_OFFSET) |
+		(1 << CSR_SPIFLASH_MMAP_MASTER_PHYCONFIG_MASK_OFFSET));
+
+	spiflash_mmap_master_cs_write(1);
+	spi_xfer(0x4B);                       /* Read Unique ID */
+	for(i=0;i<4;i++) spi_xfer(0x00);      /* 4 dummy bytes */
+	for(i=0;i<8;i++) uid[i] = spi_xfer(0x00);
+	spiflash_mmap_master_cs_write(0);
+
+	spiflash_mmap_master_phyconfig_write(saved_phyconfig);
+
+	/* All-zero or all-ones means the read did not work; keep the
+	 * compiled-in MAC rather than putting a bogus one on the wire. */
+	if((uid[0]|uid[1]|uid[2]|uid[3]|uid[4]|uid[5]|uid[6]|uid[7]) == 0x00) return;
+	if((uid[0]&uid[1]&uid[2]&uid[3]&uid[4]&uid[5]&uid[6]&uid[7]) == 0xff) return;
+
+	macadr[0] = 0x02;                     /* locally administered, unicast */
+	for(i=0;i<5;i++) macadr[i+1] = uid[i] ^ uid[i+3];
+}
+#endif
