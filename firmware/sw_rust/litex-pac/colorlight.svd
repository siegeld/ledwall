                    </fields>
                </register>
                <register>
                    <name>RGB_ORDER</name>
                    <description><![CDATA[Module channel order, indexes RGB_ORDERS (0=RGB, 1=RBG, 2=GRB, 3=GBR, 4=BRG,
5=BGR)]]></description>
                    <addressOffset>0x0008</addressOffset>
                    <resetValue>0x00</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>rgb_order</name>
                            <msb>2</msb>
                            <bitRange>[2:0]</bitRange>
                            <lsb>0</lsb>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>AUTO_SWAP</name>
                    <description><![CDATA[Flip the framebuffer in gateware at each frame boundary]]></description>
                    <addressOffset>0x000c</addressOffset>
                    <resetValue>0x00</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>auto_swap</name>
                            <msb>0</msb>
                            <bitRange>[0:0]</bitRange>
                            <lsb>0</lsb>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>FB_BASE_NOW</name>
                    <description><![CDATA[Framebuffer half currently displayed (follows auto_swap)]]></description>
                    <addressOffset>0x0010</addressOffset>
                    <resetValue>0x00</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>fb_base_now</name>
                            <msb>19</msb>
                            <bitRange>[19:0]</bitRange>
                            <lsb>0</lsb>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>UNDERRUNS</name>
                    <description><![CDATA[Pixels the serialiser latched before their memory read returned. Every one is a
wrong pixel on the glass. Zero is the target.]]></description>
                    <addressOffset>0x0014</addressOffset>
                    <resetValue>0x00</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>underruns</name>
                            <msb>31</msb>
                            <bitRange>[31:0]</bitRange>
                            <lsb>0</lsb>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>HW_COLUMNS</name>
                    <description><![CDATA[Module width in pixels, as one output drives it (read-only)]]></description>
                    <addressOffset>0x0018</addressOffset>
                    <resetValue>0x100</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>hw_columns</name>
                            <msb>15</msb>
                            <bitRange>[15:0]</bitRange>
                            <lsb>0</lsb>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>HW_ROWS</name>
                    <description><![CDATA[Module height in pixels, as one output drives it (read-only)]]></description>
                    <addressOffset>0x001c</addressOffset>
                    <resetValue>0x80</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>hw_rows</name>
                            <msb>15</msb>
                            <bitRange>[15:0]</bitRange>
                            <lsb>0</lsb>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>HW_CONFIG</name>
                    <description><![CDATA[scan[7:0], rgb_groups[11:8], n_outputs[15:12]]]></description>
                    <addressOffset>0x0020</addressOffset>
                    <resetValue>0x2440</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>hw_config</name>
                            <msb>15</msb>
                            <bitRange>[15:0]</bitRange>
                            <lsb>0</lsb>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>HW_CHIP</name>
                    <description><![CDATA[Default chip table index (see spwm_chips.CHIPS)]]></description>
                    <addressOffset>0x0024</addressOffset>
                    <resetValue>0x00</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>hw_chip</name>
                            <msb>7</msb>
                            <bitRange>[7:0]</bitRange>
                            <lsb>0</lsb>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>HW_DRIVER</name>
                    <description><![CDATA[Output stage: 0 = HUB75 bit-plane, 1 = ICND1065 S-PWM]]></description>
                    <addressOffset>0x0028</addressOffset>
                    <resetValue>0x01</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>hw_driver</name>
                            <msb>7</msb>
                            <bitRange>[7:0]</bitRange>
                            <lsb>0</lsb>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>HW_CLK_DIV</name>
                    <description><![CDATA[Panel shift clock divider (sys/N)]]></description>
                    <addressOffset>0x002c</addressOffset>
                    <resetValue>0x04</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>hw_clk_div</name>
                            <msb>7</msb>
                            <bitRange>[7:0]</bitRange>
                            <lsb>0</lsb>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>HW_PIX_BITS</name>
                    <description><![CDATA[Framebuffer bits per pixel: 32 (0x00BBGGRR) or 16 (B5G6R5)]]></description>
                    <addressOffset>0x0030</addressOffset>
                    <resetValue>0x20</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>hw_pix_bits</name>
                            <msb>7</msb>
                            <bitRange>[7:0]</bitRange>
                            <lsb>0</lsb>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>REFRESH_COUNT</name>
                    <description><![CDATA[Completed frames]]></description>
                    <addressOffset>0x0034</addressOffset>
                    <resetValue>0x00</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>refresh_count</name>
                            <msb>31</msb>
                            <bitRange>[31:0]</bitRange>
                            <lsb>0</lsb>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>PANEL0_0</name>
                    <addressOffset>0x0038</addressOffset>
                    <resetValue>0x00</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>x</name>
                            <msb>7</msb>
                            <bitRange>[7:0]</bitRange>
                            <lsb>0</lsb>
                            <description><![CDATA[x position in multiples of 16]]></description>
                        </field>
                        <field>
                            <name>y</name>
                            <msb>15</msb>
                            <bitRange>[15:8]</bitRange>
                            <lsb>8</lsb>
                            <description><![CDATA[y position in multiples of 16]]></description>
                        </field>
                        <field>
                            <name>rot</name>
                            <msb>17</msb>
                            <bitRange>[17:16]</bitRange>
                            <lsb>16</lsb>
                            <description><![CDATA[rotation, not implemented in this stage]]></description>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>PANEL1_0</name>
                    <addressOffset>0x003c</addressOffset>
                    <resetValue>0x10</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>x</name>
                            <msb>7</msb>
                            <bitRange>[7:0]</bitRange>
                            <lsb>0</lsb>
                            <description><![CDATA[x position in multiples of 16]]></description>
                        </field>
                        <field>
                            <name>y</name>
                            <msb>15</msb>
                            <bitRange>[15:8]</bitRange>
                            <lsb>8</lsb>
                            <description><![CDATA[y position in multiples of 16]]></description>
                        </field>
                        <field>
                            <name>rot</name>
                            <msb>17</msb>
                            <bitRange>[17:16]</bitRange>
                            <lsb>16</lsb>
                            <description><![CDATA[rotation, not implemented in this stage]]></description>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>GROUP0_ORIGIN</name>
                    <addressOffset>0x0040</addressOffset>
                    <resetValue>0x08</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>x</name>
                            <msb>7</msb>
                            <bitRange>[7:0]</bitRange>
                            <lsb>0</lsb>
                            <description><![CDATA[group strip x origin in the module, multiples of 16]]></description>
                        </field>
                        <field>
                            <name>y</name>
                            <msb>15</msb>
                            <bitRange>[15:8]</bitRange>
                            <lsb>8</lsb>
                            <description><![CDATA[group strip y origin in the module, multiples of 16]]></description>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>GROUP1_ORIGIN</name>
                    <addressOffset>0x0044</addressOffset>
                    <resetValue>0x408</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>x</name>
                            <msb>7</msb>
                            <bitRange>[7:0]</bitRange>
                            <lsb>0</lsb>
                            <description><![CDATA[group strip x origin in the module, multiples of 16]]></description>
                        </field>
                        <field>
                            <name>y</name>
                            <msb>15</msb>
                            <bitRange>[15:8]</bitRange>
                            <lsb>8</lsb>
                            <description><![CDATA[group strip y origin in the module, multiples of 16]]></description>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>GROUP2_ORIGIN</name>
                    <addressOffset>0x0048</addressOffset>
                    <resetValue>0x00</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>x</name>
                            <msb>7</msb>
                            <bitRange>[7:0]</bitRange>
                            <lsb>0</lsb>
                            <description><![CDATA[group strip x origin in the module, multiples of 16]]></description>
                        </field>
                        <field>
                            <name>y</name>
                            <msb>15</msb>
                            <bitRange>[15:8]</bitRange>
                            <lsb>8</lsb>
                            <description><![CDATA[group strip y origin in the module, multiples of 16]]></description>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>GROUP3_ORIGIN</name>
                    <addressOffset>0x004c</addressOffset>
                    <resetValue>0x400</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>x</name>
                            <msb>7</msb>
                            <bitRange>[7:0]</bitRange>
                            <lsb>0</lsb>
                            <description><![CDATA[group strip x origin in the module, multiples of 16]]></description>
                        </field>
                        <field>
                            <name>y</name>
                            <msb>15</msb>
                            <bitRange>[15:8]</bitRange>
                            <lsb>8</lsb>
                            <description><![CDATA[group strip y origin in the module, multiples of 16]]></description>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>HW_PALETTE_BANKS</name>
                    <description><![CDATA[Palette banks in this bitstream (2 = flips with the framebuffer)]]></description>
                    <addressOffset>0x0050</addressOffset>
                    <resetValue>0x02</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>hw_palette_banks</name>
                            <msb>3</msb>
                            <bitRange>[3:0]</bitRange>
                            <lsb>0</lsb>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>CHIP_TABLE1</name>
                    <description><![CDATA[Bits 32-63 of `HUB75_CHIP_TABLE`. Write one row of the chip register table]]></description>
                    <addressOffset>0x0054</addressOffset>
                    <resetValue>0x00</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>g</name>
                            <msb>15</msb>
                            <bitRange>[15:0]</bitRange>
                            <lsb>0</lsb>
                            <description><![CDATA[green lane word]]></description>
                        </field>
                        <field>
                            <name>b</name>
                            <msb>31</msb>
                            <bitRange>[31:16]</bitRange>
                            <lsb>16</lsb>
                            <description><![CDATA[blue lane word]]></description>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>CHIP_TABLE0</name>
                    <description><![CDATA[Bits 0-31 of `HUB75_CHIP_TABLE`.]]></description>
                    <addressOffset>0x0058</addressOffset>
                    <resetValue>0x00</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>addr</name>
                            <msb>7</msb>
                            <bitRange>[7:0]</bitRange>
                            <lsb>0</lsb>
                            <description><![CDATA[Table row: 0..MAX_REGS-1 registers, then wrappers]]></description>
                        </field>
                        <field>
                            <name>r</name>
                            <msb>31</msb>
                            <bitRange>[31:16]</bitRange>
                            <lsb>16</lsb>
                            <description><![CDATA[red lane word]]></description>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>CHIP_CFG</name>
                    <description><![CDATA[Chip grammar; reset values are the built-in default]]></description>
                    <addressOffset>0x005c</addressOffset>
                    <resetValue>0x7b08010d</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>reg_count</name>
                            <msb>6</msb>
                            <bitRange>[6:0]</bitRange>
                            <lsb>0</lsb>
                            <description><![CDATA[Registers in the rotation]]></description>
                        </field>
                        <field>
                            <name>chan_rev</name>
                            <msb>7</msb>
                            <bitRange>[7:7]</bitRange>
                            <lsb>7</lsb>
                            <description><![CDATA[Send a line channel 15->0 (11.2) not 0->15]]></description>
                        </field>
                        <field>
                            <name>slots</name>
                            <msb>11</msb>
                            <bitRange>[11:8]</bitRange>
                            <lsb>8</lsb>
                            <description><![CDATA[Register slots per frame prefix]]></description>
                        </field>
                        <field>
                            <name>rot_slot</name>
                            <msb>15</msb>
                            <bitRange>[15:12]</bitRange>
                            <lsb>12</lsb>
                            <description><![CDATA[Which slot carries the rotating register]]></description>
                        </field>
                        <field>
                            <name>mid_latch</name>
                            <msb>16</msb>
                            <bitRange>[16:16]</bitRange>
                            <lsb>16</lsb>
                            <description><![CDATA[Send the middle 11-clock LAT burst]]></description>
                        </field>
                        <field>
                            <name>row_pulse</name>
                            <msb>21</msb>
                            <bitRange>[21:17]</bitRange>
                            <lsb>17</lsb>
                            <description><![CDATA[ROW pulse width in panel clocks]]></description>
                        </field>
                        <field>
                            <name>row_pulse_first</name>
                            <msb>26</msb>
                            <bitRange>[26:22]</bitRange>
                            <lsb>22</lsb>
                            <description><![CDATA[ROW pulse width for the first row of a frame]]></description>
                        </field>
                        <field>
                            <name>data_latch</name>
                            <msb>27</msb>
                            <bitRange>[27:27]</bitRange>
                            <lsb>27</lsb>
                            <description><![CDATA[Pulse LAT at the end of each row of pixels]]></description>
                        </field>
                        <field>
                            <name>row_address</name>
                            <msb>28</msb>
                            <bitRange>[28:28]</bitRange>
                            <lsb>28</lsb>
                            <description><![CDATA[Drive A-E with the scanned row number]]></description>
                        </field>
                        <field>
                            <name>row_addr_shift</name>
                            <msb>31</msb>
                            <bitRange>[31:29]</bitRange>
                            <lsb>29</lsb>
                            <description><![CDATA[Low bits of the row to drop before A/B/C]]></description>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>ROW_SER</name>
                    <description><![CDATA[Serial row-driver mapping; all of it live]]></description>
                    <addressOffset>0x0060</addressOffset>
                    <resetValue>0x90813</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>enable</name>
                            <msb>0</msb>
                            <bitRange>[0:0]</bitRange>
                            <lsb>0</lsb>
                            <description><![CDATA[Drive A/B/C as a serial row chain, not an address]]></description>
                        </field>
                        <field>
                            <name>a_src</name>
                            <msb>2</msb>
                            <bitRange>[2:1]</bitRange>
                            <lsb>1</lsb>
                            <description><![CDATA[Pin 17: 0=DIN 1=LCK 2=BK 3=low]]></description>
                        </field>
                        <field>
                            <name>b_src</name>
                            <msb>4</msb>
                            <bitRange>[4:3]</bitRange>
                            <lsb>3</lsb>
                            <description><![CDATA[Pin 18: 0=DIN 1=LCK 2=BK 3=low]]></description>
                        </field>
                        <field>
                            <name>c_src</name>
                            <msb>6</msb>
                            <bitRange>[6:5]</bitRange>
                            <lsb>5</lsb>
                            <description><![CDATA[Pin 19: 0=DIN 1=LCK 2=BK 3=low]]></description>
                        </field>
                        <field>
                            <name>inv</name>
                            <msb>9</msb>
                            <bitRange>[9:7]</bitRange>
                            <lsb>7</lsb>
                            <description><![CDATA[Invert pins 17/18/19 after selection]]></description>
                        </field>
                        <field>
                            <name>lck_w</name>
                            <msb>13</msb>
                            <bitRange>[13:10]</bitRange>
                            <lsb>10</lsb>
                            <description><![CDATA[LCK high width, in panel bit periods]]></description>
                        </field>
                        <field>
                            <name>bk_w</name>
                            <msb>18</msb>
                            <bitRange>[18:14]</bitRange>
                            <lsb>14</lsb>
                            <description><![CDATA[BK assert width across the row change]]></description>
                        </field>
                        <field>
                            <name>lck_dly</name>
                            <msb>21</msb>
                            <bitRange>[21:19]</bitRange>
                            <lsb>19</lsb>
                            <description><![CDATA[Bit periods DIN is held before LCK rises]]></description>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>LATCH_CFG</name>
                    <addressOffset>0x0064</addressOffset>
                    <resetValue>0x1f900</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>latch_phase</name>
                            <msb>3</msb>
                            <bitRange>[3:0]</bitRange>
                            <lsb>0</lsb>
                            <description><![CDATA[Extra DATA_LATCH pulses emitted after the frame prefix. Tested 0, 1 and 15 on
hardware 2026-10-19: the pulses reach the chip (verified 1024 -> 1025 -> 1027 in
simulation at the real geometry) and the picture does not move, so the 16-pitch
dots are NOT a write-pointer phase error. Kept as an instrument; 0 is no
correction.]]></description>
                        </field>
                        <field>
                            <name>chan_xor</name>
                            <msb>7</msb>
                            <bitRange>[7:4]</bitRange>
                            <lsb>4</lsb>
                            <description><![CDATA[XOR applied to the channel index -- a permutation of the sixteen columns inside
every driver. 1 is the measured pair swap for this module. This belongs in the
gateware rather than in the firmware's pattern generator, because STREAMED
content writes the framebuffer directly and never sees a pattern-side
correction; 0 is identity.]]></description>
                        </field>
                        <field>
                            <name>sweep_adv</name>
                            <msb>10</msb>
                            <bitRange>[10:8]</bitRange>
                            <lsb>8</lsb>
                            <description><![CDATA[Advance the FETCH ADDRESS by N sweeps, carrying into the row, WITHOUT changing
the latch count. Not latch_phase: that adds DATA_LATCH pulses and moves our data
LATER against the chip's line boundary; this moves the DATA EARLIER and leaves
the count at 16 per row. The 16-pitch dots sit at the columns fed by sweep 0 --
the first latch of every row, in all eight chips -- and carry the adjacent row's
value, while simulation proves our first latch commits the RIGHT row's data.
That means the chip's line advance lands one latch later than ours, and this is
the lever for it. 0 is no correction.]]></description>
                        </field>
                        <field>
                            <name>passes</name>
                            <msb>17</msb>
                            <bitRange>[17:11]</bitRange>
                            <lsb>11</lsb>
                            <description><![CDATA[Display passes per data frame MINUS ONE -- the chip's own reg0x03. The wide W12
ROW pulse fires on row 0 of every (passes + 1)-th pass (11.6.2), and the SAME
number sets the chip's displayable grey range, 4 x (reg0x04 + 1) x (passes + 1)
(11.7.5). Runtime because each value otherwise costs a power cycle: too few and
every mixed colour clips to full, too many and the W12 cadence drifts against
the row chain (the 'rain' of 4.4). MUST match reg0x03 in the chip table.]]></description>
                        </field>
                    </fields>
                </register>
                <register>
                    <name>CLK_DIV</name>
                    <description><![CDATA[Panel shift clock divider, sys/N. Clamped to N>=2, so at 35 MHz the range is
17.5 MHz down to 137 kHz. Live.]]></description>
                    <addressOffset>0x0068</addressOffset>
                    <resetValue>0x04</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>clk_div</name>
                            <msb>7</msb>
                            <bitRange>[7:0]</bitRange>
                            <lsb>0</lsb>
                        </field>
                    </fields>
                </register>
            </registers>
            <addressBlock>
                <offset>0</offset>
                <size>0x6c</size>
                <usage>registers</usage>
            </addressBlock>
        </peripheral>
        <peripheral>
            <name>IDENTIFIER_MEM</name>
            <baseAddress>0xF0004800</baseAddress>
            <groupName>IDENTIFIER_MEM</groupName>
            <registers>
                <register>
                    <name>IDENTIFIER_MEM</name>
                    <description><![CDATA[8 x 67-bit memory]]></description>
                    <addressOffset>0x0000</addressOffset>
                    <resetValue>0x00</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>identifier_mem</name>
                            <msb>7</msb>
                            <bitRange>[7:0]</bitRange>
                            <lsb>0</lsb>
                        </field>
                    </fields>
                </register>
            </registers>
            <addressBlock>
                <offset>0</offset>
                <size>0x4</size>
                <usage>registers</usage>
            </addressBlock>
        </peripheral>
        <peripheral>
            <name>SDRAM</name>
            <baseAddress>0xF0005000</baseAddress>
            <groupName>SDRAM</groupName>
            <registers>
                <register>
                    <name>DFII_CONTROL</name>
                    <description><![CDATA[Control DFI signals common to all phases]]></description>
                    <addressOffset>0x0000</addressOffset>
                    <resetValue>0x01</resetValue>
                    <size>32</size>
                    <fields>
                        <field>
                            <name>sel</name>
                            <msb>0</msb>
                            <bitRange>[0:0]</bitRange>
                            <lsb>0</lsb>
                            <description><![CDATA[None]]></description>
                        </field>
                        <field>
                            <name>cke</name>
                            <msb>1</msb>
                            <bitRange>[1:1]</bitRange>
                            <lsb>1</lsb>
                            <description><![CDATA[DFI clock enable bus]]></description>
                        </field>
                        <field>
                            <name>odt</name>
                            <msb>2</msb>
